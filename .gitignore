.DS_Store
node_modules/
dist/
.env
.env.local
dev-dist/
*.local

# Screenshots of the incumbent app stay local and are never committed, in any format.
#
# Two reasons. They are screenshots of somebody else's proprietary interface, which does not
# belong in an AGPL repository that gets mirrored publicly. And they are photographs of a
# personal phone, timestamps and all. They were the source material for the reverse-engineering
# and the derivation records what they showed — the images themselves are not needed to build,
# test, or run anything.
example/*.PNG
example/*.png
example/*.webp
example/*.jpg
example/*.jpeg

# TypeScript incremental build artifacts — reproducible output, machine-dependent diffs.
*.tsbuildinfo

# Agent tooling and process artifacts stay local — they are not part of the product.
# GSD planning state, agent instructions, and review findings/transcripts.
.planning/
CLAUDE.md
AGENTS.md
docs/reviews/
.claude/
.codex/

# Compiled server. Reproducible from `server/` via `npm run build:server`.
dist-server/
